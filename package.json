{
  "name": "onlylocklock",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Home Assistant entity rows that can only lock a lock, close a cover or arm an alarm",
  "main": "content.js",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.13.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "npm run test:int",
    "test:int": "playwright test",
    "build": "esbuild src/index.js --bundle --format=esm --target=chrome61,edge79,firefox94,ios12,safari12 --supported:destructuring=true --minify --sourcemap --outfile=dist/content.js && acorn --ecma2018 --module --silent dist/content.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frozenwizard/onlylocklock.git"
  },
  "author": "frozenwizard",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/frozenwizard/onlylocklock/issues"
  },
  "homepage": "https://github.com/frozenwizard/onlylocklock#readme",
  "dependencies": {
    "lit": "^3.3.3"
  }
}
