{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "google"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "max-len": ["error", { "code": 120 }],
        "require-jsdoc": ["error",  {"require": {"ClassDeclaration": true}}]
    },
    "overrides": [
        {
            "files": ["playwright.config.js", "test/**/*.js"],
            "env": {
                "node": true
            },
            "rules": {
                "require-jsdoc": "off"
            }
        }
    ]
}
